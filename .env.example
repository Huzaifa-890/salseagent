# Leads source for free from OpenStreetMap (Nominatim + Overpass) - no key, no cost.
# GOOGLE_PLACES_KEY is optional: only used as a fallback if set AND OpenStreetMap found
# nothing for a niche/city. Leave blank to stay 100% free.
GOOGLE_PLACES_KEY=
# Email (Gmail: App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=
IMAP_HOST=imap.gmail.com
FROM_NAME=Your Name
COMPANY=Your Agency
BUSINESS_ADDRESS=Your business address
OWNER_EMAIL=you@yourdomain.com
BOOKING_LINK=https://calendly.com/your-link/15min
# Autopilot: comma-separated lists the agent cycles through on its own to source leads
# (cron, or the "Run autopilot" button). Leave blank to disable self-sourcing.
AUTOPILOT_NICHES=plumber,cafe,dentist,electrician
AUTOPILOT_CITIES=Sydney,Melbourne,Brisbane
# Safety (see plan: ramp up slowly, pause on trouble)
DAILY_LIMIT=0
RAMP_WEEK1=15
RAMP_WEEK2=25
RAMP_STEADY=40
BATCH_SIZE=5
BATCH_COOLDOWN_MIN=15
BOUNCE_PAUSE_THRESHOLD=0.03
FOLLOWUP_AUTOSEND=0
AUTO_REPLY_INTERESTED=1
# Login: pehli baar /login kholne par "create admin account" form aayega (database mein
# save hota hai), uske baad wahi se email+password se login. Team members baad mein
# dashboard ke "Team" panel se admin add kar sakta hai (koi public signup nahi).
# SESSION_SECRET koi lamba random string - login sessions sign karne ke liye. Local mein
# khali chhod sakte hain, Vercel par zaroor set karein (warna sab sessions restart par ud jayengi).
SESSION_SECRET=
CRON_SECRET=
# Local: khali chhod dein (local.db file banegi). Vercel par Turso ka URL + token
DATABASE_URL=
DATABASE_AUTH_TOKEN=
